npts 50 50 50                        # num.grid points in xyz
gridfld 3PP0_(3).maps.fld            # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C NA OA N SA HD     # receptor atom types
ligand_types A C Cl NA F OA N HD     # ligand atom types
receptor 3PP0_(3).pdbqt              # macromolecule
gridcenter 12.476 21.6974 34.0754    # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 3PP0_(3).A.map                   # atom-specific affinity map
map 3PP0_(3).C.map                   # atom-specific affinity map
map 3PP0_(3).Cl.map                  # atom-specific affinity map
map 3PP0_(3).NA.map                  # atom-specific affinity map
map 3PP0_(3).F.map                   # atom-specific affinity map
map 3PP0_(3).OA.map                  # atom-specific affinity map
map 3PP0_(3).N.map                   # atom-specific affinity map
map 3PP0_(3).HD.map                  # atom-specific affinity map
elecmap 3PP0_(3).e.map               # electrostatic potential map
dsolvmap 3PP0_(3).d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
